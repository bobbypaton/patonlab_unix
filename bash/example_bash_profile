# .bash_profile

# Get the aliases and functions (and conda, if you use it)
if [ -f ~/.bashrc ]; then
	. ~/.bashrc
fi

# Group software: Gaussian, NBO, Q-Chem, ORCA and OpenMPI, xtb, CREST, g-xTB, NCIPlot,
# COSMOtherm, TURBOMOLE and the group tools (qsub, GaussianPrep, OrcaPrep, autotest).
# Machines with /etc/profile.d/patonlab.sh read it at login already; elsewhere, read it
# here. Each block only takes effect if that software is installed on this machine.
if [ ! -e /etc/profile.d/patonlab.sh ] && [ -f /usr/local/patonlab_unix/bash/patonlab_profile.sh ]; then
	. /usr/local/patonlab_unix/bash/patonlab_profile.sh
fi

